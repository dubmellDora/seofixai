# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already gitignored) — this file only documents which variables the
# app reads and what they're for. All values below are placeholders.

# --- AI suggestions (required) ---
# Claude API key used to generate SEO fix suggestions and page-understanding
# context. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Keyword data providers (at least one required for Keyword Research / Rank Tracking) ---
# Semrush is tried first for keyword overview/bulk lookups.
# https://www.semrush.com/api-documentation/
SEMRUSH_API_KEY=

# DataForSEO is tried first for SERP checks (rank tracking) and related/
# question keyword suggestions, falling back to Semrush if unset or down.
# Uses HTTP Basic Auth (login/password), not a single key.
# IMPORTANT: a new DataForSEO account must be verified in their dashboard
# (https://app.dataforseo.com/) before the API will accept any call —
# otherwise every request 403s even with valid credentials.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- WordPress deploy (required to use the WordPress Auto-Deploy feature) ---
# Fernet encryption key for WordPress API tokens stored at rest in the DB.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WP_TOKEN_KEY=

# --- Google Search Console (required to use the Search Console integration) ---
# OAuth 2.0 Web application client from Google Cloud Console (APIs & Services
# > Credentials). Must have the Search Console API enabled and both the local
# (http://localhost:8000/gsc/callback) and production redirect URIs
# registered under "Authorized redirect URIs" on the client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match one of the client's registered redirect URIs -- Google
# rejects the request otherwise. Use the localhost one for local dev, the
# production one in prod's .env (see .github/workflows/deploy.yml).
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/gsc/callback
# Fernet encryption key for Google OAuth tokens stored at rest in the DB.
# Same pattern as WP_TOKEN_KEY -- generate a SEPARATE key, don't reuse
# WP_TOKEN_KEY here (a compromise of one token store must not expose the
# other). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GSC_TOKEN_KEY=

# --- Database ---
# SQLAlchemy connection string. For local dev with Docker Postgres
# (docker-compose up -d postgres), use:
#   DATABASE_URL=postgresql+psycopg2://seofixai:seofixai@localhost:5432/seofixai
# POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD configure the docker-compose
# postgres service itself and should match the credentials in DATABASE_URL.
# Falls back to sqlite:///seo_automation.db if unset (quick local runs only —
# production and docker-compose always set this explicitly).
DATABASE_URL=postgresql+psycopg2://seofixai:seofixai@localhost:5432/seofixai
POSTGRES_DB=seofixai
POSTGRES_USER=seofixai
POSTGRES_PASSWORD=seofixai

# --- Optional / not yet wired into the app ---
# Supabase push functions exist in app/supabase_client.py but currently have
# no callers anywhere in the app — safe to leave blank.
SUPABASE_URL=
SUPABASE_KEY=

# --- Hostnames / host guard (plan S0-04, decision D-010) ---
# Which hostnames this app trusts. Hostnames are configuration, never constants
# in route code. Production values:
#   PUBLIC_APP_ORIGIN=https://app.seofixai.com
#   ADMIN_APP_ORIGIN=https://admin.seofixai.com
#   LEGACY_APP_HOSTS=seofixai.com      # old URL, kept open until the cutover
# Local development uses app.localhost / admin.localhost (browsers resolve
# *.localhost to 127.0.0.1 on their own).
PUBLIC_APP_ORIGIN=http://app.localhost:8000
ADMIN_APP_ORIGIN=http://admin.localhost:8000
LEGACY_APP_HOSTS=
# The guard is installed but OFF unless this is 1/true/yes/on. While off, every
# host is accepted exactly as before. When on: unknown host -> 421, /admin on
# the public host -> 404, non-/admin paths on the admin host -> 404.
# NOTE: this only chooses the right portal. It is NOT authentication.
HOST_ENFORCEMENT=0

# S1-02: first platform admin bootstrap (development ONLY; never set in production)
# ALLOW_ADMIN_BOOTSTRAP=1
# APP_ENV=production   # when "production", the bootstrap refuses even if enabled

# S1-03b: session cookies are Secure by default. Set to 0 ONLY for local http:// development.
# COOKIE_SECURE=0

# --- Login / portals (S1-04, S1-05) ---
# Turn the login requirement on. While unset/0 the app is open exactly as before.
# AUTH_ENFORCEMENT=1
# Public sign-up page. Keep OFF on the live site until per-agency data isolation (S2-02) exists.
# REGISTRATION_ENABLED=1
# Local run with two hostnames (Chrome/Edge/Firefox resolve *.localhost automatically):
#   PUBLIC_APP_ORIGIN=http://app.localhost:8000
#   ADMIN_APP_ORIGIN=http://admin.localhost:8000
#   HOST_ENFORCEMENT=1
#   COOKIE_SECURE=0   (plain http locally)
#   uvicorn app.main:app --port 8000   ->  http://app.localhost:8000  and  http://admin.localhost:8000
# First staff account: set ALLOW_ADMIN_BOOTSTRAP=1, then run  python scripts/bootstrap_admin.py you@example.com "Your Name"
